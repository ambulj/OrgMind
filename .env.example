# FalkorDB Database Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=northwind_labs

# LLM Model Configuration (LiteLLM handles any model provider)
# Examples:
# OpenAI:       gpt-4o, gpt-4o-mini
# Anthropic:    claude-3-5-sonnet-20240620
# Google:       gemini/gemini-1.5-pro, gemini/gemini-1.5-flash
# Local Ollama: ollama/llama3
LLM_MODEL=gpt-4o

# API Keys (Provide the one corresponding to your chosen LLM_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# FalkorDB MCP Server Options
FALKORDB_DEFAULT_READONLY=true
